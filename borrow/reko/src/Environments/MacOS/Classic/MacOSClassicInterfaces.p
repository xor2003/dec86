	}
	TDesktopPrintMonitorPrintingDataPtr = ^TDesktopPrintMonitorPrintingData;
	TDesktopPrintMonitorPrintingData = RECORD
		iOpCode:				INTEGER;								{  kPrintMonitorPrGeneral }
		iError:					INTEGER;
