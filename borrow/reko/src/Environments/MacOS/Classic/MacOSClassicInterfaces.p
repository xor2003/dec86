	DL_PROMISCON_REQ			= $1F;							{  Turn on promiscuous mode  }
	DL_PROMISCOFF_REQ			= $20;							{  Turn off promiscuous mode  }
	DL_UNITDATA_REQ				= $07;							{  datagram send request, LLI compatibility  }
