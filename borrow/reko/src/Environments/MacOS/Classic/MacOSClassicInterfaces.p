 *  
 *  Availability:
 *    Non-Carbon CFM:   in MathLib 1.0 and later
 *    CarbonLib:        in CarbonLib 1.0 and later
 *    Mac OS X:         in version 10.0 or later
 }
PROCEDURE num2dec({CONST}VAR f: decform; x: double_t; VAR d: decimal); C;

{
 *  dec2num()
