			);
		4: (
			level1:				Level1VersionTuple;
			);
		5: (
			jedecID:			JEDECIdentifierTuple;
			);
		6: (
			config:				ConfigTuple;
			);
		7: (
			devGeo:				DeviceGeometryTuple;
			);
		8: (
			manufID:			ManufIDTuple;
			);
		9: (
			funcID:				FunctionIDTuple;
			);
		10: (
			swil:				SoftwareInterleaveTuple;
			);
		11: (
			level2:				Level2VersionTuple;
			);
		12: (
			format:				FormatTuple;
			);
		13: (
