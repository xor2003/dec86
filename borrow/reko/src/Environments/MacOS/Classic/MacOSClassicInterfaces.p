CONST
	MSGMARK						= $01;							{  last byte of message is tagged  }
	MSGNOLOOP					= $02;							{  don't pass message to write-side of stream  }
	MSGDELIM					= $04;							{  message is delimited  }
	MSGNOGET					= $08;

