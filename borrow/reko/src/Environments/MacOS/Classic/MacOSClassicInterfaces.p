		ataDataReg:				UInt16;									{  16 bit access only  }
		ataTFFeatures:			SInt8;									{  Error(R)  or Feature(W) register  }
		ataTFCount:				SInt8;									{  Sector Count register  }
		ataTFSector:			SInt8;									{  Sector number register  }
