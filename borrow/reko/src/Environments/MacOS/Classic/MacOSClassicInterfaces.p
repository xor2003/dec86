 }
FUNCTION CountMenuItemsWithCommandID(inMenu: MenuRef; inCommandID: MenuCommand): ItemCount;

{
 *  GetIndMenuItemWithCommandID()
 *  
 *  Summary:
 *    Finds a menu item with a specified command ID.
