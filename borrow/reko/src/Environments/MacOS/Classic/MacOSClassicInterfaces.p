	MappedFileAttributes 		= UInt32;
CONST
	kIsMappedScratchFile		= $00000001;					{  mapped file fork is scratch file  }


	{
	 	}
	kMappedFileInformationVersion1 = 1;							{  version 1 of MappedFileInformation  }



