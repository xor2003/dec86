	LinkTargetTuplePtr = ^LinkTargetTuple;
	LinkTargetTuple = RECORD
		TPLL_TAG:				PACKED ARRAY [0..2] OF Byte;			{  tag: should be 'C', 'I', 'S' }
	END;

