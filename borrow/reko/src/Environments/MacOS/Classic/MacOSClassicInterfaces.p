	catMask						= $08;							{  sets spCategory field of spTBMask (bit 3)  }
	cTypeMask					= $04;							{  sets spCType    field of spTBMask (bit 2)  }
	drvrSWMask					= $02;							{  sets spDrvrSW   field of spTBMask (bit 1)  }
