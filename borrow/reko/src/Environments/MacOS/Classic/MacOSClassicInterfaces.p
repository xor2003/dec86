	kALMDuplicateCancelButton	= 3;
	kALMDuplicatePromptText		= 5;

	kALMRenameRenameButton		= 1;							{  if Window refcon is kALMRenameDialogRefCon...  }
	kALMRenameCancelButton		= 2;
	kALMRenameEditText			= 3;
