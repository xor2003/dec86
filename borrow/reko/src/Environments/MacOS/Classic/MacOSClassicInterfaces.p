		ms_ocnt:				LONGINT;								{  count of calls to open proc  }
		ms_ccnt:				LONGINT;								{  count of calls to close proc  }
		ms_acnt:				LONGINT;								{  count of calls to admin proc  }
		ms_xptr:				CStringPtr;								{  pointer to private statistics  }
