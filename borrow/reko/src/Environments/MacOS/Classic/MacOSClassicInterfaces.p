		DGTPL_EBS:				SInt8;									{  erase block size = 2^(n-1), n>0 }
		DGTPL_RBS:				SInt8;									{  read block size = 2^(n-1), n>0 }
		DGTPL_WBS:				SInt8;									{  write block size = 2^(n-1), n>0 }
