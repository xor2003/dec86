		mi_maxpsz:				LONGINT;								{  max pkt size, for developer use  }
		mi_hiwat:				UInt32;									{  hi-water mark, for flow control  }
		mi_lowat:				UInt32;									{  lo-water mark, for flow control  }
	END;



