CONST
	DL_NONE						= $0B01;						{  no protection supplied  }
	DL_MONITOR					= $0B02;						{  protection against passive monitoring  }
	DL_MAXIMUM					= $0B03;						{  protection against modification, replay, addition, or deletion  }


