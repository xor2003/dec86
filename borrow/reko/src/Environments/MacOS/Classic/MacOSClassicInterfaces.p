	dis68k_68000 =		$0002;	{ (UInt32)	(1 << 1),	(* instruction runs on 68000 *) }
	dis68k_68010 =		$0004;	{ (UInt32)	(1 << 2),	(* instruction runs on 68010 *) }
	dis68k_68020 =		$0008;	{ (UInt32)	(1 << 3),	(* instruction runs on 68020 *) }
	dis68k_68030 =		$0010;	{ (UInt32)	(1 << 4),	(* instruction runs on 68030 *) }
	dis68k_68040 =		$0020;	{ (UInt32)	(1 << 5),	(* instruction runs on 68040 *) }
