{������������������������������������������������������������������������������������������������������}
{  Standard System 7 procIDs }


CONST
	pushButProc					= 0;
	checkBoxProc				= 1;
	radioButProc				= 2;
	scrollBarProc				= 16;
	popupMenuProc				= 1008;

	{	��������������������������������������������������������������������������������������	}
	{	  � Control Part Codes                                                                	}
	{	��������������������������������������������������������������������������������������	}
	kControlLabelPart			= 1;
	kControlMenuPart			= 2;
