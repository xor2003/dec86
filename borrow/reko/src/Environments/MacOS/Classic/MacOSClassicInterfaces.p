		header:					ICDHeader;
		object:					ICAObject;								{  <--  }
		propertyInfo:			ICAPropertyInfo;						{  <--  }
		property:				ICAProperty;							{  -->  }
	END;

	ICD_DisposePropertyPBPtr = ^ICD_DisposePropertyPB;
	ICD_DisposePropertyPB = RECORD
		header:					ICDHeader;
		property:				ICAProperty;							{  <--  }
