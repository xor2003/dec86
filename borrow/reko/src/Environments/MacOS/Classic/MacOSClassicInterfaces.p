{$SETC GENERATING68K := TARGET_CPU_68K }
{$SETC GENERATING68881 := TARGET_RT_MAC_68881 }
{$SETC GENERATINGCFM := TARGET_RT_MAC_CFM }
{$SETC CFMSYSTEMCALLS := TARGET_RT_MAC_CFM }
