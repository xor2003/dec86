    GENERATED_FLAG_PF = 0x0004u,
    GENERATED_FLAG_AF = 0x0010u,
    GENERATED_FLAG_ZF = 0x0040u,
    GENERATED_FLAG_SF = 0x0080u,
    GENERATED_FLAG_IF = 0x0200u,
    GENERATED_FLAG_DF = 0x0400u,
    GENERATED_FLAG_OF = 0x0800u
};

struct GeneratedRuntimeState {
    unsigned char memory[1u << 20u];
    uint16_t ax;
    uint16_t bx;
    uint16_t cx;
    uint16_t dx;
    uint16_t si;
    uint16_t di;
    uint16_t bp;
    uint16_t sp;
    uint16_t cs;
    uint16_t ds;
    uint16_t es;
    uint16_t ss;
    uint16_t ip;
    uint16_t flags;
    uint16_t interrupt_offset[256];
    uint16_t interrupt_segment[256];
    FILE* dos_files[32];
    uint16_t video_mode;
    unsigned int video_dirty;
    unsigned int host_video_write_count;
    unsigned int terminated;
    unsigned int exit_code;
    unsigned int poll_counter;
    unsigned int generated_io_log_count;
    uint8_t keyboard_shift_flags;
    uint16_t keyboard_peek_ax;
    unsigned int keyboard_peek_valid;
    char last_unsupported_name[96];
    char last_runtime_name[96];
    uint16_t last_dynamic_src_cs;
    uint16_t last_dynamic_src_ip;
    uint16_t last_dynamic_target_cs;
    uint16_t last_dynamic_target_ip;
    char last_dynamic_note[32];
};

