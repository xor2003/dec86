    case 0x49: return ((uint16_t)(((uint16_t)0x49u << 8u) | (uint16_t)0x00u));
    case 0x51: return ((uint16_t)(((uint16_t)0x51u << 8u) | (uint16_t)0x00u));
    case 0x52: return ((uint16_t)(((uint16_t)0x52u << 8u) | (uint16_t)0x00u));
    case 0x53: return ((uint16_t)(((uint16_t)0x53u << 8u) | (uint16_t)0x00u));
    default: return ((uint16_t)(((uint16_t)(unsigned char)(ch & 0xFF) << 8u) | (uint16_t)0x00u));
    }
}

static uint16_t generated_parse_script_key_token(const char* token) {
    uint16_t value = 0u;
    if (token == NULL || token[0] == '\0') {
        return 0u;
    }
    if (token[0] != '\0' && token[1] == '\0') {
        return generated_translate_ascii_key((unsigned char)token[0]);
    }
    if (generated_token_equals(token, "ESC") || generated_token_equals(token, "ESCAPE")) {
        return ((uint16_t)(((uint16_t)0x01u << 8u) | (uint16_t)0x1Bu));
    }
    if (generated_token_equals(token, "ENTER") || generated_token_equals(token, "RETURN")) {
        return ((uint16_t)(((uint16_t)0x1Cu << 8u) | (uint16_t)0x0Du));
    }
    if (generated_token_equals(token, "SPACE")) {
        return ((uint16_t)(((uint16_t)0x39u << 8u) | (uint16_t)' '));
    }
    if (generated_token_equals(token, "TAB")) {
        return ((uint16_t)(((uint16_t)0x0Fu << 8u) | (uint16_t)0x09u));
    }
    if (generated_token_equals(token, "BACKSPACE") || generated_token_equals(token, "BS")) {
        return ((uint16_t)(((uint16_t)0x0Eu << 8u) | (uint16_t)0x08u));
    }
    if (generated_token_equals(token, "UP")) {
        return ((uint16_t)(((uint16_t)0x48u << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "DOWN")) {
        return ((uint16_t)(((uint16_t)0x50u << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "LEFT")) {
        return ((uint16_t)(((uint16_t)0x4Bu << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "RIGHT")) {
        return ((uint16_t)(((uint16_t)0x4Du << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "HOME")) {
        return ((uint16_t)(((uint16_t)0x47u << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "END")) {
        return ((uint16_t)(((uint16_t)0x4Fu << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "PGUP") || generated_token_equals(token, "PRIOR")) {
        return ((uint16_t)(((uint16_t)0x49u << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "PGDN") || generated_token_equals(token, "NEXT")) {
        return ((uint16_t)(((uint16_t)0x51u << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "INS") || generated_token_equals(token, "INSERT")) {
        return ((uint16_t)(((uint16_t)0x52u << 8u) | (uint16_t)0x00u));
    }
    if (generated_token_equals(token, "DEL") || generated_token_equals(token, "DELETE")) {
        return ((uint16_t)(((uint16_t)0x53u << 8u) | (uint16_t)0x00u));
    }
    if ((generated_ascii_upper((unsigned char)token[0]) == 'A') &&
        (generated_ascii_upper((unsigned char)token[1]) == 'X') &&
        token[2] == '=' &&
        generated_parse_hex_u16(token + 3, &value) != 0u) {
        return value;
    }
    if (generated_parse_hex_u16(token, &value) != 0u) {
        return value;
    }
    return 0u;
}

static void generated_load_scripted_keys_from_env(GeneratedHostState& h) {
    const char* script = getenv("MZ2CPP_SCRIPT_KEYS");
    char* buffer = NULL;
    char* cursor = NULL;
    uint32_t schedule_ms = 0u;
    if (script == NULL || script[0] == '\0') {
        return;
    }
    buffer = static_cast<char*>(malloc(strlen(script) + 1u));
    if (buffer == NULL) {
        return;
    }
    memcpy(buffer, script, strlen(script) + 1u);
    cursor = buffer;
    while (*cursor != '\0') {
        char* token_begin = cursor;
        char* token_end = NULL;
        uint16_t key_ax = 0u;
        while (*token_begin == ' ' || *token_begin == '\t' || *token_begin == ',' || *token_begin == ';') {
            ++token_begin;
        }
        token_end = token_begin;
        while (*token_end != '\0' && *token_end != ',' && *token_end != ';') {
            ++token_end;
        }
        if (*token_end != '\0') {
            *token_end = '\0';
            cursor = token_end + 1;
        } else {
            cursor = token_end;
        }
        while (token_end > token_begin && (token_end[-1] == ' ' || token_end[-1] == '\t')) {
            token_end[-1] = '\0';
            --token_end;
        }
        if (token_begin[0] == '\0') {
            continue;
        }
        if (((generated_ascii_upper((unsigned char)token_begin[0]) == 'W') &&
             (generated_ascii_upper((unsigned char)token_begin[1]) == 'A') &&
             (generated_ascii_upper((unsigned char)token_begin[2]) == 'I') &&
             (generated_ascii_upper((unsigned char)token_begin[3]) == 'T') &&
             token_begin[4] == '=') ||
            ((generated_ascii_upper((unsigned char)token_begin[0]) == 'D') &&
             (generated_ascii_upper((unsigned char)token_begin[1]) == 'E') &&
             (generated_ascii_upper((unsigned char)token_begin[2]) == 'L') &&
             (generated_ascii_upper((unsigned char)token_begin[3]) == 'A') &&
             (generated_ascii_upper((unsigned char)token_begin[4]) == 'Y') &&
             token_begin[5] == '=') ||
            ((generated_ascii_upper((unsigned char)token_begin[0]) == 'P') &&
             (generated_ascii_upper((unsigned char)token_begin[1]) == 'A') &&
             (generated_ascii_upper((unsigned char)token_begin[2]) == 'U') &&
             (generated_ascii_upper((unsigned char)token_begin[3]) == 'S') &&
             (generated_ascii_upper((unsigned char)token_begin[4]) == 'E') &&
             token_begin[5] == '=')) {
            uint32_t delay_ms = 0u;
            const char* value_text = strchr(token_begin, '=');
            if (value_text != NULL && generated_parse_decimal_u32(value_text + 1, &delay_ms) != 0u) {
                schedule_ms += delay_ms;
            }
            continue;
        }
        key_ax = generated_parse_script_key_token(token_begin);
        if (key_ax != 0u) {
            h.scripted_keys.push_back(GeneratedScriptedKeyEvent{key_ax, schedule_ms});
        }
    }
    free(buffer);
}

static void generated_flush_scripted_keys(GeneratedHostState& h) {
    const auto now = std::chrono::steady_clock::now();
    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - h.tick_epoch).count();
    while (h.scripted_key_index < h.scripted_keys.size()) {
        const GeneratedScriptedKeyEvent& event = h.scripted_keys[h.scripted_key_index];
        if ((uint64_t)elapsed < (uint64_t)event.due_ms) {
            break;
        }
        h.key_queue.push_back(event.key_ax);
        ++h.scripted_key_index;
    }
}

static unsigned generated_poll_keyboard(GeneratedRuntimeState* state, uint16_t* out_ax) {
    GeneratedHostState& h = generated_host();
    generated_host_poll(state);
    if (state->keyboard_peek_valid != 0u) {
        *out_ax = state->keyboard_peek_ax;
        return 1u;
    }
    if (!h.key_queue.empty()) {
        state->keyboard_peek_ax = h.key_queue.front();
        h.key_queue.pop_front();
        state->keyboard_peek_valid = 1u;
        *out_ax = state->keyboard_peek_ax;
        return 1u;
    }
    if (_kbhit() == 0) {
        return 0u;
    }
    {
        const int first = _getch();
        if (first == 0 || first == 0xE0) {
            state->keyboard_peek_ax = generated_translate_extended_key(_getch());
        } else {
            state->keyboard_peek_ax = generated_translate_ascii_key(first);
        }
    }
    state->keyboard_peek_valid = 1u;
    *out_ax = state->keyboard_peek_ax;
    return 1u;
}

static uint16_t generated_wait_keyboard(GeneratedRuntimeState* state) {
    uint16_t key_ax = 0u;
    if (state->video_mode == 0x000Du || state->video_mode == 0x0013u) {
        generated_present_video(state);
        state->video_dirty = 0u;
    }
    while (generated_poll_keyboard(state, &key_ax) == 0u) {
        if (state->video_mode == 0x000Du || state->video_mode == 0x0013u) {
            generated_present_video(state);
            state->video_dirty = 0u;
        }
        generated_host_poll(state);
        Sleep(1u);
    }
    state->keyboard_peek_valid = 0u;
    return key_ax;
}

static uint16_t generated_consume_keyboard(GeneratedRuntimeState* state) {
    const uint16_t key_ax = generated_wait_keyboard(state);
    state->keyboard_peek_ax = 0u;
    return key_ax;
}

static unsigned generated_dos_find_free_handle(const GeneratedRuntimeState* state) {
    unsigned handle = 5u;
    while (handle < 32u) {
        if (state->dos_files[handle] == NULL) {
            return handle;
        }
        ++handle;
    }
    return 0u;
}

static void generated_dos_read_buffer(GeneratedRuntimeState* state, uint16_t segment, uint16_t offset, FILE* file, uint16_t count) {
    uint16_t index = 0u;
    while (index < count) {
        const int byte_value = fgetc(file);
        if (byte_value == EOF) {
            break;
        }
        generated_write_u8(state, segment, (uint16_t)(offset + index), (unsigned char)(byte_value & 0xFF));
        ++index;
    }
    state->ax = index;
}

static uint16_t generated_dos_write_buffer(GeneratedRuntimeState* state, uint16_t segment, uint16_t offset, FILE* file, uint16_t count) {
    uint16_t index = 0u;
    while (index < count) {
        const unsigned char byte_value = generated_read_u8(state, segment, (uint16_t)(offset + index));
        if (fputc((int)byte_value, file) == EOF) {
            break;
        }
        ++index;
    }
    return index;
}

static void generated_log_dos_io(GeneratedRuntimeState* state, const char* message) {
    if (state->generated_io_log_count >= 128u) {
        return;
    }
    ++state->generated_io_log_count;
    printf("generated dos %u: %s\n", state->generated_io_log_count, message);
}

static void generated_dispatch_irq0_if_due(GeneratedRuntimeState* state) {
    GeneratedHostState& h = generated_host();
    const auto now = std::chrono::steady_clock::now();
    const char* trace_irq0 = getenv("MZ2CPP_TRACE_IRQ0");
    if (now < h.next_irq0) {
        return;
    }
    h.next_irq0 = now + generated_pit_period_for_divisor(h.pit_ch0_divisor);
    if (trace_irq0 != NULL && trace_irq0[0] == '1' && h.irq0_trace_count < 64u) {
        char trace_message[192];
        snprintf(trace_message,
                 sizeof(trace_message),
                 "poll cs:ip=%04X:%04X flags=%04X if=%u depth=%u term=%u vec08=%04X:%04X",
                 state != NULL ? (unsigned)state->cs : 0u,
                 state != NULL ? (unsigned)state->ip : 0u,
                 state != NULL ? (unsigned)state->flags : 0u,
                 state != NULL ? generated_get_flag(state, GENERATED_FLAG_IF) : 0u,
                 (unsigned)h.active_hw_interrupts.size(),
                 state != NULL ? state->terminated : 0u,
                 state != NULL ? (unsigned)state->interrupt_segment[0x08u] : 0u,
                 state != NULL ? (unsigned)state->interrupt_offset[0x08u] : 0u);
        generated_append_trace_line("irq0_poll", trace_message);
        ++h.irq0_trace_count;
    }
    if (state == NULL || state->terminated != 0u) {
        return;
    }
    if (h.runtime_service_depth != 0) {
        generated_bios_tick_advance(state);
        return;
    }
    if (!h.active_hw_interrupts.empty()) {
        return;
    }
    if (generated_get_flag(state, GENERATED_FLAG_IF) == 0u) {
        return;
    }
    {
        const uint16_t target_cs = state->interrupt_segment[0x08u];
        const uint16_t target_ip = state->interrupt_offset[0x08u];
        const size_t depth_before = h.active_hw_interrupts.size();
        if (target_cs == 0u && target_ip == 0u) {
            return;
        }
        generated_push_u16(state, state->flags);
        generated_push_u16(state, state->cs);
        generated_push_u16(state, state->ip);
        generated_set_flag(state, GENERATED_FLAG_IF, 0u);
        generated_set_flag(state, 0x0100u, 0u);
        state->cs = target_cs;
        state->ip = target_ip;
        h.active_hw_interrupts.push_back(0x08u);
        if (generated_dispatch_root(state, target_cs, target_ip) == 0u) {
            if (h.active_hw_interrupts.size() > depth_before) {
                h.active_hw_interrupts.resize(depth_before);
            }
            state->ip = generated_pop_u16(state);
            state->cs = generated_pop_u16(state);
            state->flags = generated_pop_u16(state);
            return;
        }
        if (h.active_hw_interrupts.size() != depth_before) {
            h.active_hw_interrupts.resize(depth_before);
            state->ip = generated_pop_u16(state);
            state->cs = generated_pop_u16(state);
            state->flags = generated_pop_u16(state);
        }
    }
}

void generated_host_poll(GeneratedRuntimeState* state) {
    GeneratedHostState& h = generated_host();
    generated_ensure_window(state);
    generated_pump_messages();
    generated_flush_scripted_keys(h);
    if (state == NULL || state->terminated != 0u) {
        return;
    }
    generated_dispatch_irq0_if_due(state);
    generated_dispatch_irq1_if_pending(state);
    if (state->terminated != 0u) {
        return;
    }
    if (state->video_dirty != 0u && std::chrono::steady_clock::now() >= h.next_present) {
        generated_present_video(state);
        state->video_dirty = 0u;
        h.next_present = std::chrono::steady_clock::now() + std::chrono::milliseconds(16);
    }
}

void generated_interrupt(GeneratedRuntimeState* state, unsigned char vector) {
    generated_host_poll(state);
    GeneratedRuntimeServiceGuard guard(generated_host());
    switch (vector) {
    case 0x10u: {
        GeneratedHostState& h = generated_host();
        const unsigned char ah = (unsigned char)((state->ax >> 8u) & 0x00FFu);
        switch (ah) {
        case 0x00u:
            state->video_mode = (uint16_t)(state->ax & 0x00FFu);
            if (state->video_mode == 0x000Du) {
                generated_reset_planar_state(state);
            } else if (state->video_mode == 0x0013u) {
                memset(state->memory + kGeneratedGraphicsVideoPhys, 0, kGeneratedMode13VideoEndPhys - kGeneratedGraphicsVideoPhys);
            }
            state->video_dirty = 1u;
            generated_host_poll(state);
            return;
        case 0x02u:
            return;
        case 0x03u:
            state->cx = 0u;
            return;
        case 0x05u: {
            const uint8_t page = (uint8_t)(state->ax & 0x00FFu);
            if (state->video_mode == 0x000Du) {
                h.crtc_start_addr = (uint16_t)((uint16_t)(page & 0x07u) * 0x2000u);
                state->video_dirty = 1u;
            }
            return;
        }
        case 0x0Fu:
            state->ax = (uint16_t)((state->ax & 0xFF00u) | (state->video_mode & 0x00FFu));
            state->ax = (uint16_t)((state->ax & 0x00FFu) | (80u << 8u));
            state->bx = (uint16_t)(state->bx & 0x00FFu);
            if (state->video_mode == 0x000Du) {
                state->bx = (uint16_t)(state->bx | (((uint16_t)((h.crtc_start_addr >> 13u) & 0x07u)) << 8u));
            }
            return;
        case 0x0Cu: {
            const uint8_t color = (uint8_t)(state->ax & 0x00FFu);
            if (state->video_mode == 0x0013u) {
                if (state->cx < 320u && state->dx < 200u) {
                    state->memory[kGeneratedGraphicsVideoPhys + (uint32_t)state->dx * 320u + state->cx] = color;
                    state->video_dirty = 1u;
                }
            } else if (state->video_mode == 0x000Du) {
                generated_mode0d_plot_pixel(state, state->cx, state->dx, (uint8_t)(color & 0x0Fu), (color & 0x80u) != 0u);
            }
            return;
        }
        case 0x0Du:
            if (state->video_mode == 0x0013u) {
                if (state->cx < 320u && state->dx < 200u) {
                    state->ax = (uint16_t)((state->ax & 0xFF00u) | state->memory[kGeneratedGraphicsVideoPhys + (uint32_t)state->dx * 320u + state->cx]);
                } else {
                    state->ax = (uint16_t)(state->ax & 0xFF00u);
                }
            } else if (state->video_mode == 0x000Du) {
                state->ax = (uint16_t)((state->ax & 0xFF00u) | generated_mode0d_read_pixel(state->cx, state->dx));
            } else {
                state->ax = (uint16_t)(state->ax & 0xFF00u);
            }
            return;
        case 0x10u: {
            const uint8_t al = (uint8_t)(state->ax & 0x00FFu);
            switch (al) {
            case 0x00u:
                generated_set_palette_index_alias(h, (uint8_t)(state->bx & 0x00FFu), (uint8_t)((state->bx >> 8u) & 0x00FFu));
                state->video_dirty = 1u;
                return;
            case 0x02u: {
                uint16_t base = state->dx;
                uint16_t i = 0u;
                uint8_t palette_values[16];
                while (i < 16u) {
                    const uint8_t palette_value = generated_read_u8(state, state->es, (uint16_t)(base + i));
                    palette_values[i] = palette_value;
                    generated_set_palette_index_alias(h, (uint8_t)i, palette_value);
                    ++i;
                }
                {
                    const char* trace_palette = getenv("MZ2CPP_TRACE_PALETTE");
                    if (trace_palette != NULL && trace_palette[0] == '1') {
                        char trace_message[256];
                        snprintf(trace_message,
                                 sizeof(trace_message),
                                 "int10_1002 es:dx=%04X:%04X values=[%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X,%02X]",
                                 (unsigned)state->es,
                                 (unsigned)state->dx,
                                 (unsigned)palette_values[0],
                                 (unsigned)palette_values[1],
                                 (unsigned)palette_values[2],
                                 (unsigned)palette_values[3],
                                 (unsigned)palette_values[4],
                                 (unsigned)palette_values[5],
                                 (unsigned)palette_values[6],
                                 (unsigned)palette_values[7],
                                 (unsigned)palette_values[8],
                                 (unsigned)palette_values[9],
                                 (unsigned)palette_values[10],
                                 (unsigned)palette_values[11],
                                 (unsigned)palette_values[12],
                                 (unsigned)palette_values[13],
                                 (unsigned)palette_values[14],
                                 (unsigned)palette_values[15]);
                        generated_append_trace_line("palette", trace_message);
                    }
                }
                state->video_dirty = 1u;
                return;
            }
            case 0x10u:
                generated_set_palette_dac_entry(h,
                    (uint16_t)(state->bx & 0x00FFu),
                    (uint8_t)((state->dx >> 8u) & 0x00FFu),
                    (uint8_t)((state->cx >> 8u) & 0x00FFu),
                    (uint8_t)(state->cx & 0x00FFu));
                state->video_dirty = 1u;
                return;
            case 0x12u: {
                uint16_t index = state->bx;
                uint16_t ptr = state->dx;
                uint16_t i = 0u;
                while (i < state->cx) {
                    const uint8_t r6 = generated_read_u8(state, state->es, ptr++);
                    const uint8_t g6 = generated_read_u8(state, state->es, ptr++);
                    const uint8_t b6 = generated_read_u8(state, state->es, ptr++);
                    generated_set_palette_dac_entry(h, (uint16_t)(index + i), r6, g6, b6);
                    ++i;
                }
                state->video_dirty = 1u;
                return;
            }
            default:
                return;
            }
        }
        default:
            return;
        }
    }
    case 0x16u: {
        const unsigned char ah = (unsigned char)((state->ax >> 8u) & 0x00FFu);
        switch (ah) {
        case 0x00u:
            state->ax = generated_consume_keyboard(state);
            generated_set_flag(state, GENERATED_FLAG_ZF, 0u);
            return;
        case 0x01u: {
            uint16_t key_ax = 0u;
            if (generated_poll_keyboard(state, &key_ax) != 0u) {
                state->ax = key_ax;
                generated_set_flag(state, GENERATED_FLAG_ZF, 0u);
            } else {
                generated_set_flag(state, GENERATED_FLAG_ZF, 1u);
            }
            return;
        }
        case 0x02u:
            state->ax = (uint16_t)((state->ax & 0xFF00u) | state->keyboard_shift_flags);
            generated_set_flag(state, GENERATED_FLAG_ZF, 0u);
            return;
        default:
            generated_set_flag(state, GENERATED_FLAG_ZF, 1u);
            return;
        }
    }
    case 0x21u: {
        const unsigned char ah = (unsigned char)((state->ax >> 8u) & 0x00FFu);
        const unsigned char al = (unsigned char)(state->ax & 0x00FFu);
        if (generated_trace_env_enabled("MZ2CPP_TRACE_INT21")) {
            char trace_message[256];
            snprintf(trace_message,
                     sizeof(trace_message),
                     "ax=%04X bx=%04X cx=%04X dx=%04X ds=%04X es=%04X ss=%04X sp=%04X flags=%04X",
                     (unsigned)state->ax,
                     (unsigned)state->bx,
                     (unsigned)state->cx,
                     (unsigned)state->dx,
                     (unsigned)state->ds,
                     (unsigned)state->es,
                     (unsigned)state->ss,
                     (unsigned)state->sp,
                     (unsigned)state->flags);
            generated_append_trace_line("int21", trace_message);
        }
        switch (ah) {
        case 0x3Du: {
            const unsigned access = (unsigned)(al & 0x03u);
            const char* path = (const char*)(state->memory + generated_phys(state->ds, state->dx));
            const char* mode = "rb";
            unsigned handle = 0u;
            FILE* file = NULL;
            if (access == 1u) {
                mode = "wb";
            } else if (access == 2u) {
                mode = "rb+";
            }
            handle = generated_dos_find_free_handle(state);
            if (handle == 0u) {
                state->ax = 0x0004u;
                generated_set_flag(state, GENERATED_FLAG_CF, 1u);
                return;
            }
            file = fopen(path, mode);
            if (file == NULL && access == 2u) {
                file = fopen(path, "rb");
            }
            if (file == NULL) {
                state->ax = 0x0002u;
                generated_set_flag(state, GENERATED_FLAG_CF, 1u);
                return;
            }
            state->dos_files[handle] = file;
            state->ax = (uint16_t)handle;
            {
                char message[192];
                snprintf(message, sizeof(message), "open '%s' -> handle=%u", path, handle);
                generated_log_dos_io(state, message);
            }
            generated_set_flag(state, GENERATED_FLAG_CF, 0u);
            return;
        }
        case 0x3Eu: {
            const unsigned handle = (unsigned)state->bx;
            if (handle >= 32u || state->dos_files[handle] == NULL) {
                state->ax = 0x0006u;
                generated_set_flag(state, GENERATED_FLAG_CF, 1u);
                return;
            }
            {
                char message[96];
                snprintf(message, sizeof(message), "close handle=%u", handle);
                generated_log_dos_io(state, message);
            }
            fclose(state->dos_files[handle]);
            state->dos_files[handle] = NULL;
            state->ax = 0x0000u;
            generated_set_flag(state, GENERATED_FLAG_CF, 0u);
            return;
        }
        case 0x3Fu: {
            const unsigned handle = (unsigned)state->bx;
            if (handle >= 32u || state->dos_files[handle] == NULL) {
                state->ax = 0x0006u;
                generated_set_flag(state, GENERATED_FLAG_CF, 1u);
                return;
            }
            generated_dos_read_buffer(state, state->ds, state->dx, state->dos_files[handle], state->cx);
            if (state->ax == 0u || state->generated_io_log_count < 16u) {
                char message[128];
                snprintf(message, sizeof(message), "read handle=%u count=%u -> %u", handle, (unsigned)state->cx, (unsigned)state->ax);
                generated_log_dos_io(state, message);
            }
            generated_set_flag(state, GENERATED_FLAG_CF, 0u);
            return;
        }
        case 0x40u: {
            const unsigned handle = (unsigned)state->bx;
            if (handle == 1u || handle == 2u) {
                uint16_t index = 0u;
                while (index < state->cx) {
                    putchar((int)generated_read_u8(state, state->ds, (uint16_t)(state->dx + index)));
                    ++index;
                }
                fflush(stdout);
                state->ax = state->cx;
                {
                    char message[128];
                    snprintf(message, sizeof(message), "write std handle=%u count=%u -> %u", handle, (unsigned)state->cx, (unsigned)state->ax);
                    generated_log_dos_io(state, message);
                }
                generated_set_flag(state, GENERATED_FLAG_CF, 0u);
                return;
            }
            if (handle >= 32u || state->dos_files[handle] == NULL) {
                state->ax = 0x0006u;
                generated_set_flag(state, GENERATED_FLAG_CF, 1u);
                return;
            }
            state->ax = generated_dos_write_buffer(state, state->ds, state->dx, state->dos_files[handle], state->cx);
            fflush(state->dos_files[handle]);
            {
                char message[128];
                snprintf(message, sizeof(message), "write handle=%u count=%u -> %u", handle, (unsigned)state->cx, (unsigned)state->ax);
                generated_log_dos_io(state, message);
            }
            generated_set_flag(state, GENERATED_FLAG_CF, 0u);
            return;
        }
        case 0x09u: {
            const char* text = (const char*)(state->memory + generated_phys(state->ds, state->dx));
            while (*text != '\0' && *text != '$') {
                putchar(*text++);
            }
            return;
        }
        case 0x25u:
            state->interrupt_offset[al] = state->dx;
            state->interrupt_segment[al] = state->ds;
            return;
        case 0x35u:
            state->bx = state->interrupt_offset[al];
            state->es = state->interrupt_segment[al];
            return;
        case 0x4Cu:
            state->exit_code = al;
            state->terminated = 1u;
            return;
        default:
            return;
        }
    }
    default:
        return;
    }
}

unsigned generated_check_condition(const GeneratedRuntimeState* state, unsigned opcode) {
    switch (opcode & 0x0Fu) {
    case 0x00u: return generated_get_flag(state, GENERATED_FLAG_OF);
    case 0x01u: return !generated_get_flag(state, GENERATED_FLAG_OF);
    case 0x02u: return generated_get_flag(state, GENERATED_FLAG_CF);
    case 0x03u: return !generated_get_flag(state, GENERATED_FLAG_CF);
    case 0x04u: return generated_get_flag(state, GENERATED_FLAG_ZF);
    case 0x05u: return !generated_get_flag(state, GENERATED_FLAG_ZF);
    case 0x06u: return generated_get_flag(state, GENERATED_FLAG_CF) || generated_get_flag(state, GENERATED_FLAG_ZF);
    case 0x07u: return !generated_get_flag(state, GENERATED_FLAG_CF) && !generated_get_flag(state, GENERATED_FLAG_ZF);
    case 0x08u: return generated_get_flag(state, GENERATED_FLAG_SF);
    case 0x09u: return !generated_get_flag(state, GENERATED_FLAG_SF);
    case 0x0Au: return generated_get_flag(state, GENERATED_FLAG_PF);
    case 0x0Bu: return !generated_get_flag(state, GENERATED_FLAG_PF);
    case 0x0Cu: return generated_get_flag(state, GENERATED_FLAG_SF) != generated_get_flag(state, GENERATED_FLAG_OF);
    case 0x0Du: return generated_get_flag(state, GENERATED_FLAG_SF) == generated_get_flag(state, GENERATED_FLAG_OF);
    case 0x0Eu: return generated_get_flag(state, GENERATED_FLAG_ZF) ||
                       (generated_get_flag(state, GENERATED_FLAG_SF) != generated_get_flag(state, GENERATED_FLAG_OF));
    case 0x0Fu: return !generated_get_flag(state, GENERATED_FLAG_ZF) &&
                       (generated_get_flag(state, GENERATED_FLAG_SF) == generated_get_flag(state, GENERATED_FLAG_OF));
    }
    return 0u;
}

#undef GENERATED_KEY_AX

void generated_runtime_init(GeneratedRuntimeState* state) {
    memset(state, 0, sizeof(*state));
    g_generated_active_state = state;
    for (size_t i = 0u; i < kGeneratedCodeRegionCount; ++i) {
        const GeneratedMemoryRegion& region = kGeneratedCodeRegions[i];
        memcpy(state->memory + region.physical, region.bytes, region.size);
    }
    for (size_t i = 0u; i < kGeneratedNamedStaticSymbolCount; ++i) {
        const GeneratedNamedStaticSymbol& symbol = kGeneratedNamedStaticSymbols[i];
        memcpy(state->memory + symbol.physical, symbol.bytes, symbol.size);
    }
    for (size_t i = 0u; i < kGeneratedResidualRegionCount; ++i) {
        const GeneratedMemoryRegion& region = kGeneratedResidualRegions[i];
        memcpy(state->memory + region.physical, region.bytes, region.size);
    }
    state->memory[kGeneratedPspPhysical + 0x0000u] = 0xCDu;
    state->memory[kGeneratedPspPhysical + 0x0001u] = 0x20u;
    state->memory[kGeneratedPspPhysical + 0x0002u] = 0xFFu;
    state->memory[kGeneratedPspPhysical + 0x0003u] = 0x9Fu;
    state->memory[kGeneratedPspPhysical + 0x0080u] = 0x00u;
    state->cs = kGeneratedEntryCS;
    state->ip = kGeneratedEntryIP;
    state->ss = kGeneratedStackSS;
    state->sp = kGeneratedStackSP;
    state->ds = kGeneratedLoadSegment;
    state->es = kGeneratedLoadSegment;
    state->flags = GENERATED_FLAG_IF;
    state->video_mode = 0x0003u;
    state->video_dirty = 1u;
    state->host_video_write_count = 0u;
    state->keyboard_shift_flags = 0u;
    state->keyboard_peek_ax = 0u;
    state->keyboard_peek_valid = 0u;
    state->interrupt_offset[0x08u] = kGeneratedHostStubInt08Offset;
    state->interrupt_segment[0x08u] = kGeneratedHostStubSegment;
    state->interrupt_offset[0x09u] = kGeneratedHostStubInt09Offset;
    state->interrupt_segment[0x09u] = kGeneratedHostStubSegment;
    state->interrupt_offset[0x24u] = 0x0000u;
    state->interrupt_segment[0x24u] = 0x0000u;
    generated_reset_planar_state(state);
    generated_host().tick_epoch = std::chrono::steady_clock::now();
    generated_host().next_present = generated_host().tick_epoch;
    generated_host().next_irq0 = generated_host().tick_epoch + generated_pit_period_for_divisor(generated_host().pit_ch0_divisor);
    generated_host().pit_ch0_low_byte_pending = false;
    generated_host().pit_ch0_low_byte = 0u;
    generated_host().pit_ch0_divisor = 0u;
    generated_host().key_queue.clear();
    generated_host().keyboard_scan_queue.clear();
    generated_host().scripted_keys.clear();
    generated_host().scripted_key_index = 0u;
    generated_host().active_hw_interrupts.clear();
    generated_host().keyboard_controller_data = 0u;
    generated_host().persistent_dynamic_targets.clear();
    generated_host().dynamic_targets_loaded = false;
    generated_host().runtime_service_depth = 0;
    generated_load_scripted_keys_from_env(generated_host());
    generated_load_dynamic_target_db(generated_host());
    state->memory[generated_phys(kGeneratedHostStubSegment, kGeneratedHostStubInt08Offset)] = 0xCFu;
    state->memory[generated_phys(kGeneratedHostStubSegment, kGeneratedHostStubInt09Offset)] = 0xCFu;
    generated_write_u16(state, 0x0000u, 0x08u * 4u, kGeneratedHostStubInt08Offset);
    generated_write_u16(state, 0x0000u, 0x08u * 4u + 2u, kGeneratedHostStubSegment);
    generated_write_u16(state, 0x0000u, 0x09u * 4u, kGeneratedHostStubInt09Offset);
    generated_write_u16(state, 0x0000u, 0x09u * 4u + 2u, kGeneratedHostStubSegment);
    generated_host_poll(state);
}

static void generated_copy_note(char* dst, size_t dst_size, const char* src);

void generated_note_dynamic_target(GeneratedRuntimeState* state,
                                   uint16_t src_cs,
                                   uint16_t src_ip,
                                   uint16_t target_cs,
                                   uint16_t target_ip,
                                   const char* note) {
    if (state != NULL) {
        state->last_dynamic_src_cs = src_cs;
        state->last_dynamic_src_ip = src_ip;
        state->last_dynamic_target_cs = target_cs;
        state->last_dynamic_target_ip = target_ip;
        generated_copy_note(state->last_dynamic_note, sizeof(state->last_dynamic_note), note);
    }
    fprintf(stderr,
            "dynamic_target: %04X:%04X -> %04X:%04X (%s)\n",
            (unsigned)src_cs,
            (unsigned)src_ip,
            (unsigned)target_cs,
            (unsigned)target_ip,
            note != NULL ? note : "dynamic");
    fflush(stderr);
    if (!generated_is_in_original_image_range(target_cs, target_ip)) {
        return;
    }
    GeneratedHostState& h = generated_host();
    generated_load_dynamic_target_db(h);
    {
        const uint64_t key = generated_dynamic_target_key(src_cs, src_ip, target_cs, target_ip);
        if (!h.persistent_dynamic_targets.insert(key).second) {
            return;
        }
    }
    {
        char line[96];
        snprintf(line,
                 sizeof(line),
                 "SRC %04X:%04X TARGET %04X:%04X",
                 (unsigned)src_cs,
                 (unsigned)src_ip,
                 (unsigned)target_cs,
                 (unsigned)target_ip);
        generated_append_text_line(generated_dynamic_target_db_path(), line);
    }
    {
        char trace_message[128];
        snprintf(trace_message,
                 sizeof(trace_message),
                 "new %04X:%04X from %04X:%04X (%s)",
                 (unsigned)target_cs,
                 (unsigned)target_ip,
                 (unsigned)src_cs,
                 (unsigned)src_ip,
                 note != NULL ? note : "dynamic");
        generated_append_trace_line("dynamic_target", trace_message);
    }
}

static void generated_copy_note(char* dst, size_t dst_size, const char* src) {
    if (dst_size == 0u) {
        return;
    }
    if (src == NULL) {
        dst[0] = '\0';
        return;
    }
    strncpy(dst, src, dst_size - 1u);
    dst[dst_size - 1u] = '\0';
}

static unsigned generated_trace_env_enabled(const char* name) {
    const char* value = getenv(name);
    return value != NULL && value[0] == '1';
}

static unsigned generated_trace_call_matches(const char* name) {
    const char* filter = getenv("MZ2CPP_TRACE_CALL_FILTER");
    if (name == NULL) {
        return 0u;
    }
    if (filter == NULL || filter[0] == '\0') {
        return 1u;
    }

    while (*filter != '\0') {
        while (*filter == ' ' || *filter == '\t' || *filter == ',' || *filter == ';') {
            ++filter;
        }
        const char* token_start = filter;
        while (*filter != '\0' && *filter != ',' && *filter != ';') {
            ++filter;
        }
        const char* token_end = filter;
        while (token_end > token_start &&
               (token_end[-1] == ' ' || token_end[-1] == '\t')) {
            --token_end;
        }
        const size_t token_length = (size_t)(token_end - token_start);
        if (token_length != 0u) {
            char token[128];
            const size_t copy_length = token_length < (sizeof(token) - 1u) ? token_length : (sizeof(token) - 1u);
            memcpy(token, token_start, copy_length);
            token[copy_length] = '\0';
            if (strstr(name, token) != NULL) {
                return 1u;
            }
        }
    }

    return 0u;
}

void generated_runtime_note_call(GeneratedRuntimeState* state, const char* name) {
    const unsigned is_unsupported =
        name != NULL && (strncmp(name, "unsupported_", 12u) == 0 || strncmp(name, "divide_", 7u) == 0);
    generated_copy_note(state->last_runtime_name, sizeof(state->last_runtime_name), name);
    ++state->poll_counter;
    if ((state->poll_counter & 0x001Fu) == 0u) {
        generated_host_poll(state);
    }
    if (is_unsupported) {
        generated_copy_note(state->last_unsupported_name, sizeof(state->last_unsupported_name), name);
        generated_append_trace_line("unsupported", name);
    }
    if (generated_trace_env_enabled("MZ2CPP_TRACE_CALLS") &&
        generated_trace_call_matches(name)) {
        char trace_message[256];
        snprintf(trace_message,
                 sizeof(trace_message),
                 "%s cs:ip=%04X:%04X ax=%04X bx=%04X cx=%04X dx=%04X si=%04X di=%04X bp=%04X ds=%04X es=%04X ss:sp=%04X:%04X",
                 name != NULL ? name : "(null)",
                 state != NULL ? (unsigned)state->cs : 0u,
                 state != NULL ? (unsigned)state->ip : 0u,
                 state != NULL ? (unsigned)state->ax : 0u,
                 state != NULL ? (unsigned)state->bx : 0u,
                 state != NULL ? (unsigned)state->cx : 0u,
                 state != NULL ? (unsigned)state->dx : 0u,
                 state != NULL ? (unsigned)state->si : 0u,
                 state != NULL ? (unsigned)state->di : 0u,
                 state != NULL ? (unsigned)state->bp : 0u,
                 state != NULL ? (unsigned)state->ds : 0u,
                 state != NULL ? (unsigned)state->es : 0u,
                 state != NULL ? (unsigned)state->ss : 0u,
                 state != NULL ? (unsigned)state->sp : 0u);
        generated_append_trace_line("call", trace_message);
    }
}

void generated_dump_termination_state(const GeneratedRuntimeState* state, FILE* file) {
    if (state == NULL || file == NULL) {
        return;
    }

    fprintf(file,
            "termination: reason=%s terminated=%u exit=%u\n",
            state->last_unsupported_name[0] != '\0' ? state->last_unsupported_name : "none",
            state->terminated,
            state->exit_code);
    fprintf(file,
            "location: cs:ip=%04X:%04X phys=%05X ss:sp=%04X:%04X top=%04X %04X %04X\n",
            (unsigned)state->cs,
            (unsigned)state->ip,
            (unsigned)generated_phys(state->cs, state->ip),
            (unsigned)state->ss,
            (unsigned)state->sp,
            (unsigned)generated_read_u16(state, state->ss, state->sp),
            (unsigned)generated_read_u16(state, state->ss, (uint16_t)(state->sp + 2u)),
            (unsigned)generated_read_u16(state, state->ss, (uint16_t)(state->sp + 4u)));
    fprintf(file,
            "regs: ax=%04X bx=%04X cx=%04X dx=%04X si=%04X di=%04X bp=%04X ds=%04X es=%04X flags=%04X\n",
            (unsigned)state->ax,
            (unsigned)state->bx,
            (unsigned)state->cx,
            (unsigned)state->dx,
            (unsigned)state->si,
            (unsigned)state->di,
            (unsigned)state->bp,
            (unsigned)state->ds,
            (unsigned)state->es,
            (unsigned)state->flags);
    fprintf(file,
            "flow: last_runtime=%s polls=%u io_logs=%u video_mode=%u dirty=%u host_writes=%u\n",
            state->last_runtime_name[0] != '\0' ? state->last_runtime_name : "none",
            state->poll_counter,
            state->generated_io_log_count,
            (unsigned)state->video_mode,
            state->video_dirty,
            state->host_video_write_count);
    if (state->last_dynamic_note[0] != '\0') {
        fprintf(file,
                "dynamic: %04X:%04X -> %04X:%04X (%s)\n",
                (unsigned)state->last_dynamic_src_cs,
                (unsigned)state->last_dynamic_src_ip,
                (unsigned)state->last_dynamic_target_cs,
                (unsigned)state->last_dynamic_target_ip,
                state->last_dynamic_note);
    }
}

