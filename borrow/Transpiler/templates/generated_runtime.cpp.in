        case 0x0Du: return static_cast<unsigned char>(h.crtc_start_addr & 0x00FFu);
        default: return 0u;
        }
    case 0x03DAu: {
        const auto now = std::chrono::steady_clock::now();
        const auto us = std::chrono::duration_cast<std::chrono::microseconds>(now - h.tick_epoch).count();
        constexpr long long kPeriodUs = 14285;
        constexpr long long kPulseUs = 1200;
        const long long phase = kPeriodUs > 0 ? (us % kPeriodUs) : 0;
        const bool vblank = phase < kPulseUs;
        h.attr_expect_data = false;
        if (!vblank) {
            std::this_thread::yield();
        }
        return static_cast<unsigned char>((vblank ? 0x08u : 0x00u) | (vblank ? 0x01u : 0x00u));
    }
    default:
        return 0u;
    }
}

void generated_port_out_u8(GeneratedRuntimeState* state, uint16_t port, unsigned char value) {
