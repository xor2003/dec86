void generated_reset_runtime_state(GeneratedRuntimeState* state) {
    memset(state, 0, sizeof(*state));
}

uint32_t generated_phys(uint16_t segment, uint16_t offset) {
    return (((uint32_t)segment << 4u) + (uint32_t)offset) & 0xFFFFFu;
}

namespace {

template <typename RegionT, typename PhysicalFn, typename SizeFn>
const RegionT* generated_find_region_covering_impl(const RegionT* regions,
                                                   size_t count,
                                                   uint32_t physical,
                                                   size_t* byte_offset,
                                                   PhysicalFn physical_fn,
                                                   SizeFn size_fn) {
    size_t lo = 0u;
    size_t hi = count;
    while (lo < hi) {
        const size_t mid = lo + ((hi - lo) / 2u);
        if (physical_fn(regions[mid]) <= physical) {
            lo = mid + 1u;
        } else {
            hi = mid;
        }
    }
    if (lo == 0u) {
        return NULL;
    }
    const RegionT& region = regions[lo - 1u];
    const uint32_t start = physical_fn(region);
    const size_t size = size_fn(region);
    const uint32_t end = start + static_cast<uint32_t>(size);
    if (physical < start || physical >= end) {
        return NULL;
    }
    if (byte_offset != NULL) {
        *byte_offset = static_cast<size_t>(physical - start);
    }
    return &region;
}

constexpr uint32_t kGeneratedGraphicsVideoPhys = 0xA0000u;
constexpr uint32_t kGeneratedGraphicsVideoEndPhys = 0xB0000u;
constexpr uint32_t kGeneratedMode13VideoEndPhys = 0xAFA00u;
constexpr UINT_PTR kGeneratedPresentTimerId = 1u;
constexpr uint16_t kGeneratedHostStubSegment = 0xF000u;
constexpr uint16_t kGeneratedHostStubInt08Offset = 0x0100u;
constexpr uint16_t kGeneratedHostStubInt09Offset = 0x0110u;

