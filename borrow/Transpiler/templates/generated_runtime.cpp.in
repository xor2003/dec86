    HWND hwnd = NULL;
    bool window_class_registered = false;
    std::deque<uint16_t> key_queue;
    std::deque<uint8_t> keyboard_scan_queue;
    std::vector<GeneratedScriptedKeyEvent> scripted_keys;
    size_t scripted_key_index = 0u;
    std::unordered_set<uint16_t> key_down;
    uint8_t keyboard_controller_data = 0u;
    std::array<uint32_t, 256> palette{};
    std::array<uint8_t, 16> attr_palette{};
    uint8_t attr_index = 0u;
    bool attr_expect_data = false;
    uint8_t dac_write_index = 0u;
    uint8_t dac_component = 0u;
    std::array<uint8_t, 3> dac_triplet = {0u, 0u, 0u};
    uint8_t sequencer_index = 0u;
    uint8_t sequencer_map_mask = 0x0Fu;
    uint16_t sequencer_map_mask_seen = 0u;
    uint8_t graphics_index = 0u;
    uint8_t gc_set_reset = 0u;
    uint8_t gc_enable_set_reset = 0u;
    uint8_t gc_color_compare = 0u;
    uint8_t gc_data_rotate = 0u;
    uint8_t gc_read_map_select = 0u;
    uint8_t gc_mode = 0u;
    uint8_t gc_misc = 0u;
    uint8_t gc_color_dont_care = 0x0Fu;
    uint8_t gc_bit_mask = 0xFFu;
    std::array<std::vector<uint8_t>, 4> planar{};
    std::array<uint8_t, 4> gc_latch = {0u, 0u, 0u, 0u};
    bool gc_word_latch_valid = false;
    uint16_t gc_word_latch_off = 0u;
    std::array<uint8_t, 4> gc_word_latch_lo = {0u, 0u, 0u, 0u};
    std::array<uint8_t, 4> gc_word_latch_hi = {0u, 0u, 0u, 0u};
    std::vector<uint32_t> frame_argb;
    unsigned irq0_trace_count = 0u;
    uint8_t crtc_index = 0u;
    uint16_t crtc_start_addr = 0u;
    std::array<uint32_t, 8> mode0d_page_write_count = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
    std::array<uint32_t, 4> mode0d_plane_write_count = {0u, 0u, 0u, 0u};
    std::array<uint32_t, 4> mode0d_plane_nonzero_write_count = {0u, 0u, 0u, 0u};
    unsigned mode0d_write_trace_count = 0u;
    std::chrono::steady_clock::time_point tick_epoch = std::chrono::steady_clock::now();
    std::chrono::steady_clock::time_point next_present = std::chrono::steady_clock::now();
    std::chrono::steady_clock::time_point next_irq0 = std::chrono::steady_clock::now();
    bool pit_ch0_low_byte_pending = false;
    uint8_t pit_ch0_low_byte = 0u;
    uint16_t pit_ch0_divisor = 0u;
    std::vector<uint8_t> active_hw_interrupts;
    std::unordered_set<uint64_t> persistent_dynamic_targets;
    bool dynamic_targets_loaded = false;
    int runtime_service_depth = 0;
};

