        return 0u;
    case 0x03CFu:
        switch (h.graphics_index) {
        case 0x00u: return h.gc_set_reset;
        case 0x01u: return h.gc_enable_set_reset;
        case 0x02u: return h.gc_color_compare;
        case 0x03u: return h.gc_data_rotate;
        case 0x04u: return h.gc_read_map_select;
        case 0x05u: return h.gc_mode;
        case 0x06u: return h.gc_misc;
        case 0x07u: return h.gc_color_dont_care;
        case 0x08u: return h.gc_bit_mask;
