    GeneratedHostState& h;
    explicit GeneratedRuntimeServiceGuard(GeneratedHostState& state) : h(state) { ++h.runtime_service_depth; }
    ~GeneratedRuntimeServiceGuard() { --h.runtime_service_depth; }
};

uint32_t generated_ega64_index_to_argb(uint8_t value) {
    const uint32_t r = ((value & 0x04u) ? 0xAAu : 0u) + ((value & 0x20u) ? 0x55u : 0u);
    const uint32_t g = ((value & 0x02u) ? 0xAAu : 0u) + ((value & 0x10u) ? 0x55u : 0u);
    const uint32_t b = ((value & 0x01u) ? 0xAAu : 0u) + ((value & 0x08u) ? 0x55u : 0u);
    return 0xFF000000u | (r << 16u) | (g << 8u) | b;
}

uint32_t generated_vga_rgb6_to_argb(uint8_t r6, uint8_t g6, uint8_t b6) {
    const uint32_t r = static_cast<uint32_t>(r6 & 0x3Fu) * 255u / 63u;
    const uint32_t g = static_cast<uint32_t>(g6 & 0x3Fu) * 255u / 63u;
    const uint32_t b = static_cast<uint32_t>(b6 & 0x3Fu) * 255u / 63u;
    return 0xFF000000u | (r << 16u) | (g << 8u) | b;
}

static const char* generated_dynamic_target_db_path(void) {
    const char* explicit_path = getenv("MZ2CPP_DYNAMIC_TARGET_DB");
    if (explicit_path != NULL && explicit_path[0] != '\0') {
        return explicit_path;
    }
    return "mz2cpp_dynamic_targets.txt";
}

static unsigned generated_is_in_original_image_range(uint16_t cs, uint16_t ip) {
    const uint32_t phys = generated_phys(cs, ip);
    return phys >= kGeneratedLoadModulePhysical && phys < kGeneratedImageEndPhysical;
}

static uint64_t generated_dynamic_target_key(uint16_t src_cs,
                                             uint16_t src_ip,
                                             uint16_t target_cs,
                                             uint16_t target_ip) {
    const uint32_t source = (((uint32_t)src_cs & 0xFFFFu) << 16u) | ((uint32_t)src_ip & 0xFFFFu);
    const uint32_t target = (((uint32_t)target_cs & 0xFFFFu) << 16u) | ((uint32_t)target_ip & 0xFFFFu);
    return ((uint64_t)source << 32u) | (uint64_t)target;
}

static void generated_load_dynamic_target_db(GeneratedHostState& h) {
    if (h.dynamic_targets_loaded) {
        return;
    }
    h.dynamic_targets_loaded = true;
    {
        FILE* file = fopen(generated_dynamic_target_db_path(), "rb");
        if (file == NULL) {
            return;
        }
        char line[128];
        while (fgets(line, sizeof(line), file) != NULL) {
            unsigned parsed_src_cs = 0u;
            unsigned parsed_src_ip = 0u;
            unsigned parsed_cs = 0u;
            unsigned parsed_ip = 0u;
            if (sscanf(line, "SRC %x:%x TARGET %x:%x", &parsed_src_cs, &parsed_src_ip, &parsed_cs, &parsed_ip) == 4) {
                const uint64_t key =
                    generated_dynamic_target_key((uint16_t)parsed_src_cs,
                                                (uint16_t)parsed_src_ip,
                                                (uint16_t)parsed_cs,
                                                (uint16_t)parsed_ip);
                h.persistent_dynamic_targets.insert(key);
                continue;
            }
            if (sscanf(line, "PC %x:%x", &parsed_cs, &parsed_ip) == 2) {
                const uint64_t key =
                    generated_dynamic_target_key(0xFFFFu, 0xFFFFu, (uint16_t)parsed_cs, (uint16_t)parsed_ip);
                h.persistent_dynamic_targets.insert(key);
            }
        }
        fclose(file);
    }
}

static void generated_append_text_line(const char* path, const char* text) {
    if (path == NULL || path[0] == '\0' || text == NULL) {
        return;
    }
    {
        FILE* file = fopen(path, "ab");
        if (file == NULL) {
            return;
        }
        fprintf(file, "%s\n", text);
        fclose(file);
    }
}

std::chrono::microseconds generated_pit_period_for_divisor(uint16_t divisor) {
    const uint64_t counts = divisor == 0u ? 65536ull : (uint64_t)divisor;
    uint64_t us = (counts * 1000000ull + 596591ull) / 1193182ull;
    if (us == 0ull) {
        us = 1ull;
    }
    return std::chrono::microseconds(us);
}

GeneratedHostState& generated_host() {
    static GeneratedHostState host_state = [] {
        GeneratedHostState h;
        size_t i = 0u;
        while (i < h.palette.size()) {
            const uint32_t c = static_cast<uint32_t>(i & 0xFFu);
            h.palette[i] = 0xFF000000u | (c << 16u) | (c << 8u) | c;
            ++i;
        }
        i = 0u;
        while (i < 64u) {
            h.palette[i] = generated_ega64_index_to_argb(static_cast<uint8_t>(i));
            ++i;
        }
        i = 0u;
        while (i < h.attr_palette.size()) {
            h.attr_palette[i] = static_cast<uint8_t>(i);
            ++i;
        }
        i = 0u;
        while (i < h.planar.size()) {
            h.planar[i].assign(0x10000u, 0u);
            ++i;
        }
        return h;
    }();
    return host_state;
}

void generated_set_palette_index_alias(GeneratedHostState& h, uint8_t reg, uint8_t value) {
    if (reg < h.attr_palette.size()) {
        h.attr_palette[reg] = static_cast<uint8_t>(value & 0x3Fu);
    }
}

void generated_set_palette_dac_entry(GeneratedHostState& h, uint16_t index, uint8_t r6, uint8_t g6, uint8_t b6) {
    if (index < h.palette.size()) {
        h.palette[index] = generated_vga_rgb6_to_argb(r6, g6, b6);
    }
}

void generated_clear_word_latch(GeneratedHostState& h) {
    h.gc_word_latch_valid = false;
}

void generated_reset_planar_state(GeneratedRuntimeState* state) {
    GeneratedHostState& h = generated_host();
    size_t i = 0u;
    h.attr_index = 0u;
    h.attr_expect_data = false;
    h.dac_write_index = 0u;
    h.dac_component = 0u;
    h.dac_triplet[0] = 0u;
    h.dac_triplet[1] = 0u;
    h.dac_triplet[2] = 0u;
    h.sequencer_index = 0u;
    h.sequencer_map_mask = 0x0Fu;
    h.sequencer_map_mask_seen = (uint16_t)(1u << h.sequencer_map_mask);
    h.graphics_index = 0u;
    h.gc_set_reset = 0u;
    h.gc_enable_set_reset = 0u;
    h.gc_color_compare = 0u;
    h.gc_data_rotate = 0u;
    h.gc_read_map_select = 0u;
    h.gc_mode = 0u;
    h.gc_misc = 0u;
    h.gc_color_dont_care = 0x0Fu;
    h.gc_bit_mask = 0xFFu;
    h.crtc_index = 0u;
    h.crtc_start_addr = 0u;
    h.mode0d_page_write_count = {0u, 0u, 0u, 0u, 0u, 0u, 0u, 0u};
    h.mode0d_plane_write_count = {0u, 0u, 0u, 0u};
    h.mode0d_plane_nonzero_write_count = {0u, 0u, 0u, 0u};
    h.mode0d_write_trace_count = 0u;
    h.irq0_trace_count = 0u;
    while (i < h.attr_palette.size()) {
        h.attr_palette[i] = static_cast<uint8_t>(i);
        ++i;
    }
    i = 0u;
    while (i < 64u) {
        h.palette[i] = generated_ega64_index_to_argb(static_cast<uint8_t>(i));
        ++i;
    }
    generated_clear_word_latch(h);
    i = 0u;
    while (i < h.planar.size()) {
        std::fill(h.planar[i].begin(), h.planar[i].end(), static_cast<uint8_t>(0u));
        h.gc_latch[i] = 0u;
        ++i;
    }
    if (state != NULL) {
        std::fill(state->memory + kGeneratedGraphicsVideoPhys,
                  state->memory + kGeneratedGraphicsVideoEndPhys,
                  static_cast<uint8_t>(0u));
    }
}

uint8_t generated_rotate_right8(uint8_t value, uint8_t count) {
    count = static_cast<uint8_t>(count & 7u);
    if (count == 0u) {
        return value;
    }
    return static_cast<uint8_t>((value >> count) | (value << (8u - count)));
}

uint8_t generated_raster_op(uint8_t src, uint8_t latch, uint8_t op) {
    switch (op & 0x03u) {
    case 0u: return src;
    case 1u: return static_cast<uint8_t>(src & latch);
    case 2u: return static_cast<uint8_t>(src | latch);
    default: return static_cast<uint8_t>(src ^ latch);
    }
}

uint8_t generated_mode0d_peek_byte_no_latch(const GeneratedHostState& h, uint16_t off) {
    if (off >= h.planar[0].size()) {
        return 0u;
    }
    if (((h.gc_mode >> 3u) & 0x01u) == 0u) {
        return h.planar[h.gc_read_map_select & 0x03u][off];
    }
    {
        uint8_t out = 0u;
        uint8_t bit = 0u;
        while (bit < 8u) {
            const uint8_t mask = static_cast<uint8_t>(0x80u >> bit);
            uint8_t color = 0u;
            uint8_t plane = 0u;
            while (plane < 4u) {
                color = static_cast<uint8_t>(color | (((h.planar[plane][off] & mask) ? 1u : 0u) << plane));
                ++plane;
            }
            if ((((color ^ h.gc_color_compare) & h.gc_color_dont_care) & 0x0Fu) == 0u) {
                out = static_cast<uint8_t>(out | mask);
            }
            ++bit;
        }
        return out;
    }
}

uint8_t generated_mode0d_read_byte(const GeneratedRuntimeState*, uint16_t off) {
    GeneratedHostState& h = generated_host();
    if (off >= h.planar[0].size()) {
        return 0u;
    }
    {
        uint8_t plane = 0u;
        while (plane < 4u) {
            h.gc_latch[plane] = h.planar[plane][off];
            ++plane;
        }
    }
    if (((h.gc_mode >> 3u) & 0x01u) == 0u) {
        return h.gc_latch[h.gc_read_map_select & 0x03u];
    }
    return generated_mode0d_peek_byte_no_latch(h, off);
}

void generated_mode0d_write_byte(GeneratedRuntimeState* state, uint16_t off, uint8_t value) {
    GeneratedHostState& h = generated_host();
    if (off >= h.planar[0].size()) {
        return;
    }
    const uint8_t write_mode = static_cast<uint8_t>(h.gc_mode & 0x03u);
    const uint8_t rotate = static_cast<uint8_t>(h.gc_data_rotate & 0x07u);
    const uint8_t raster = static_cast<uint8_t>((h.gc_data_rotate >> 3u) & 0x03u);
    const uint8_t bit_mask = h.gc_bit_mask;
    const uint8_t rotated = generated_rotate_right8(value, rotate);
    uint8_t plane = 0u;
    while (plane < 4u) {
        const uint8_t plane_mask = static_cast<uint8_t>(1u << plane);
        const uint8_t latch = h.gc_latch[plane];
        uint8_t result = h.planar[plane][off];
        switch (write_mode) {
        case 0u: {
            uint8_t src = rotated;
            if ((h.gc_enable_set_reset & plane_mask) != 0u) {
                src = (h.gc_set_reset & plane_mask) ? 0xFFu : 0x00u;
            }
            src = generated_raster_op(src, latch, raster);
            result = static_cast<uint8_t>((src & bit_mask) | (latch & static_cast<uint8_t>(~bit_mask)));
            break;
        }
        case 1u:
            result = latch;
            break;
        case 2u: {
            uint8_t src = (value & plane_mask) ? 0xFFu : 0x00u;
            src = generated_raster_op(src, latch, raster);
            result = static_cast<uint8_t>((src & bit_mask) | (latch & static_cast<uint8_t>(~bit_mask)));
            break;
        }
        default: {
            const uint8_t src = (h.gc_set_reset & plane_mask) ? 0xFFu : 0x00u;
            const uint8_t mask = static_cast<uint8_t>(rotated & bit_mask);
            result = static_cast<uint8_t>((src & mask) | (latch & static_cast<uint8_t>(~mask)));
            break;
        }
        }
        if ((h.sequencer_map_mask & plane_mask) != 0u) {
            h.planar[plane][off] = result;
            ++h.mode0d_plane_write_count[plane];
            if (result != 0u) {
                ++h.mode0d_plane_nonzero_write_count[plane];
            }
        }
        ++plane;
    }
    {
        const char* trace_writes = getenv("MZ2CPP_TRACE_MODE0D_WRITES");
        if (trace_writes != NULL && trace_writes[0] == '1' && h.mode0d_write_trace_count < 4096u) {
            char trace_message[256];
            snprintf(trace_message,
                     sizeof(trace_message),
                     "ip=%04X:%04X off=%04X value=%02X seq=%02X gcmode=%02X gr=%02X bitmask=%02X latch=[%02X,%02X,%02X,%02X] planes=[%02X,%02X,%02X,%02X]",
                     (unsigned)state->cs,
                     (unsigned)state->ip,
                     (unsigned)off,
                     (unsigned)value,
                     (unsigned)h.sequencer_map_mask,
                     (unsigned)h.gc_mode,
                     (unsigned)h.gc_data_rotate,
                     (unsigned)h.gc_bit_mask,
                     (unsigned)h.gc_latch[0],
                     (unsigned)h.gc_latch[1],
                     (unsigned)h.gc_latch[2],
                     (unsigned)h.gc_latch[3],
                     (unsigned)h.planar[0][off],
                     (unsigned)h.planar[1][off],
                     (unsigned)h.planar[2][off],
                     (unsigned)h.planar[3][off]);
            generated_append_trace_line("mode0d_write", trace_message);
            ++h.mode0d_write_trace_count;
        }
    }
    ++h.mode0d_page_write_count[(off >> 13u) & 0x07u];
    state->video_dirty = 1u;
}

void generated_mode0d_plot_pixel(GeneratedRuntimeState* state, uint16_t x, uint16_t y, uint8_t color, bool xor_mode) {
    GeneratedHostState& h = generated_host();
    if (x >= 320u || y >= 200u) {
        return;
    }
    {
        const uint16_t off = static_cast<uint16_t>(y * 40u + (x >> 3u));
        const uint8_t mask = static_cast<uint8_t>(0x80u >> (x & 7u));
        uint8_t pixel = static_cast<uint8_t>(color & 0x0Fu);
        if (xor_mode) {
            uint8_t old = 0u;
            uint8_t plane = 0u;
            while (plane < 4u) {
                old = static_cast<uint8_t>(old | (((h.planar[plane][off] & mask) ? 1u : 0u) << plane));
                ++plane;
            }
            pixel = static_cast<uint8_t>(pixel ^ old);
        }
        {
            uint8_t plane = 0u;
            while (plane < 4u) {
                uint8_t* dst = &h.planar[plane][off];
                if (((pixel >> plane) & 1u) != 0u) {
                    *dst = static_cast<uint8_t>(*dst | mask);
                } else {
                    *dst = static_cast<uint8_t>(*dst & static_cast<uint8_t>(~mask));
                }
                ++plane;
            }
        }
        state->memory[kGeneratedGraphicsVideoPhys + off] = generated_mode0d_peek_byte_no_latch(h, off);
        state->video_dirty = 1u;
    }
}

uint8_t generated_mode0d_read_pixel(uint16_t x, uint16_t y) {
    GeneratedHostState& h = generated_host();
    if (x >= 320u || y >= 200u) {
        return 0u;
    }
    {
        const uint16_t off = static_cast<uint16_t>(y * 40u + (x >> 3u));
        const uint8_t mask = static_cast<uint8_t>(0x80u >> (x & 7u));
        uint8_t pixel = 0u;
        uint8_t plane = 0u;
        while (plane < 4u) {
            pixel = static_cast<uint8_t>(pixel | (((h.planar[plane][off] & mask) ? 1u : 0u) << plane));
            ++plane;
        }
        return pixel;
    }
}

void generated_apply_keyboard_scan_to_shift_flags(GeneratedRuntimeState* state, uint8_t scan_byte) {
    const uint8_t scan = static_cast<uint8_t>(scan_byte & 0x7Fu);
    const bool is_break = (scan_byte & 0x80u) != 0u;
    switch (scan) {
    case 0x2Au:
        if (is_break) state->keyboard_shift_flags &= static_cast<uint8_t>(~0x02u);
        else state->keyboard_shift_flags |= 0x02u;
        break;
    case 0x36u:
        if (is_break) state->keyboard_shift_flags &= static_cast<uint8_t>(~0x01u);
        else state->keyboard_shift_flags |= 0x01u;
        break;
    case 0x1Du:
        if (is_break) state->keyboard_shift_flags &= static_cast<uint8_t>(~0x04u);
        else state->keyboard_shift_flags |= 0x04u;
        break;
    case 0x38u:
        if (is_break) state->keyboard_shift_flags &= static_cast<uint8_t>(~0x08u);
        else state->keyboard_shift_flags |= 0x08u;
        break;
    default:
        break;
    }
}

void generated_blt_argb_frame(HWND hwnd, HDC dc, const std::vector<uint32_t>& frame, int width, int height) {
    BITMAPINFO bmi{};
    RECT rc{};
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = width;
    bmi.bmiHeader.biHeight = -height;
    bmi.bmiHeader.biPlanes = 1;
    bmi.bmiHeader.biBitCount = 32;
    bmi.bmiHeader.biCompression = BI_RGB;
    GetClientRect(hwnd, &rc);
    StretchDIBits(dc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
                  0, 0, width, height, frame.data(), &bmi, DIB_RGB_COLORS, SRCCOPY);
}

void generated_append_trace_line(const char* category, const char* message) {
    const char* path = getenv("MZ2CPP_TRACE_FILE");
    fprintf(stderr,
            "%s: %s\n",
            category != NULL ? category : "trace",
            message != NULL ? message : "");
    fflush(stderr);
    if (path == NULL || path[0] == '\0') {
        return;
    }
    {
        FILE* file = fopen(path, "ab");
        if (file == NULL) {
            return;
        }
        fprintf(file,
                "%s: %s\n",
                category != NULL ? category : "trace",
                message != NULL ? message : "");
        fclose(file);
    }
}

bool generated_parse_trace_word_addr(uint16_t* out_segment, uint16_t* out_offset) {
    const char* spec = getenv("MZ2CPP_TRACE_WORD_ADDR");
    unsigned seg = 0u;
    unsigned off = 0u;
    if (spec == NULL || spec[0] == '\0') {
        return false;
    }
    if (spec[0] == '*' && spec[1] == ':') {
        if (sscanf(spec + 2, "%x", &off) != 1) {
            return false;
        }
        if (out_segment != NULL) {
            *out_segment = 0xFFFFu;
        }
        if (out_offset != NULL) {
            *out_offset = (uint16_t)(off & 0xFFFFu);
        }
        return true;
    }
    if (sscanf(spec, "%x:%x", &seg, &off) != 2) {
        return false;
    }
    if (out_segment != NULL) {
        *out_segment = (uint16_t)(seg & 0xFFFFu);
    }
    if (out_offset != NULL) {
        *out_offset = (uint16_t)(off & 0xFFFFu);
    }
    return true;
}

bool generated_trace_word_addr_matches(uint16_t segment, uint16_t offset) {
    uint16_t watch_segment = 0u;
    uint16_t watch_offset = 0u;
    if (!generated_parse_trace_word_addr(&watch_segment, &watch_offset)) {
        return false;
    }
    if (offset != watch_offset) {
        return false;
    }
    return watch_segment == 0xFFFFu || segment == watch_segment;
}

void generated_trace_word_access(const GeneratedRuntimeState* state,
                                 const char* kind,
                                 uint16_t segment,
                                 uint16_t offset,
                                 uint16_t value) {
    char message[256];
    snprintf(message,
             sizeof(message),
             "%s %04X:%04X=%04X cs:ip=%04X:%04X ds=%04X es=%04X ss=%04X sp=%04X",
             kind != NULL ? kind : "word",
             (unsigned)segment,
             (unsigned)offset,
             (unsigned)value,
             state != NULL ? (unsigned)state->cs : 0u,
             state != NULL ? (unsigned)state->ip : 0u,
             state != NULL ? (unsigned)state->ds : 0u,
             state != NULL ? (unsigned)state->es : 0u,
             state != NULL ? (unsigned)state->ss : 0u,
             state != NULL ? (unsigned)state->sp : 0u);
    generated_append_trace_line("word", message);
}

void generated_render_mode0d_page_to_frame(GeneratedHostState& h, uint16_t base, std::vector<uint32_t>* out_frame) {
    if (out_frame == NULL) {
        return;
    }
    if (out_frame->size() != 320u * 200u) {
        out_frame->assign(320u * 200u, 0u);
    }
    {
        uint16_t y = 0u;
        while (y < 200u) {
            uint16_t xb = 0u;
            while (xb < 40u) {
                const uint16_t off = static_cast<uint16_t>(base + y * 40u + xb);
                const uint8_t p0 = h.planar[0][off];
                const uint8_t p1 = h.planar[1][off];
                const uint8_t p2 = h.planar[2][off];
                const uint8_t p3 = h.planar[3][off];
                uint8_t bit = 0u;
                while (bit < 8u) {
                    const uint8_t mask = static_cast<uint8_t>(0x80u >> bit);
                    uint8_t pix = 0u;
                    pix = static_cast<uint8_t>(pix | ((p0 & mask) ? 1u : 0u));
                    pix = static_cast<uint8_t>(pix | (((p1 & mask) ? 1u : 0u) << 1u));
                    pix = static_cast<uint8_t>(pix | (((p2 & mask) ? 1u : 0u) << 2u));
                    pix = static_cast<uint8_t>(pix | (((p3 & mask) ? 1u : 0u) << 3u));
                    (*out_frame)[(size_t)y * 320u + (size_t)xb * 8u + bit] =
                        h.palette[h.attr_palette[pix & 0x0Fu] & 0xFFu];
                    ++bit;
                }
                ++xb;
            }
            ++y;
        }
    }
}

LRESULT CALLBACK GeneratedHostWindowProc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam) {
    GeneratedHostState& h = generated_host();
    switch (msg) {
    case WM_TIMER:
        if (wparam == kGeneratedPresentTimerId && g_generated_active_state != NULL && g_generated_active_state->video_dirty != 0u) {
            generated_present_video(g_generated_active_state);
            g_generated_active_state->video_dirty = 0u;
            h.next_present = std::chrono::steady_clock::now() + std::chrono::milliseconds(16);
            return 0;
        }
        return DefWindowProcA(hwnd, msg, wparam, lparam);
    case WM_PAINT: {
        PAINTSTRUCT ps{};
        HDC dc = BeginPaint(hwnd, &ps);
        if (dc != NULL) {
            if (h.frame_argb.size() == 320u * 200u) {
                generated_blt_argb_frame(hwnd, dc, h.frame_argb, 320, 200);
            } else {
                RECT rc{};
                HBRUSH black = CreateSolidBrush(RGB(0, 0, 0));
                GetClientRect(hwnd, &rc);
                FillRect(dc, &rc, black);
                DeleteObject(black);
            }
        }
        EndPaint(hwnd, &ps);
        return 0;
    }
    case WM_DESTROY:
        KillTimer(hwnd, kGeneratedPresentTimerId);
        if (g_generated_active_state != NULL) {
            g_generated_active_state->terminated = 1u;
            g_generated_active_state->exit_code = 0u;
        }
        PostQuitMessage(0);
        h.hwnd = NULL;
        return 0;
    case WM_KEYDOWN:
    case WM_SYSKEYDOWN: {
        const bool was_down = (lparam & 0x40000000u) != 0;
        UINT scan_code = static_cast<UINT>((lparam >> 16) & 0xFFu);
        if (scan_code == 0u) {
            scan_code = MapVirtualKeyA(static_cast<UINT>(wparam), MAPVK_VK_TO_VSC);
        }
        {
            const uint16_t scan = static_cast<uint16_t>(scan_code & 0xFFu);
            if (was_down || h.key_down.find(scan) != h.key_down.end()) {
                return 0;
            }
            h.key_down.insert(scan);
            BYTE key_state[256];
            WORD translated = 0;
            unsigned char ascii = 0u;
            if (!GetKeyboardState(key_state)) {
                memset(key_state, 0, sizeof(key_state));
            }
            if (ToAscii(static_cast<UINT>(wparam), scan_code, key_state, &translated, 0) == 1) {
                ascii = static_cast<unsigned char>(translated & 0x00FFu);
            }
            if (g_generated_active_state != NULL) {
                generated_apply_keyboard_scan_to_shift_flags(g_generated_active_state, static_cast<uint8_t>(scan));
            }
            h.keyboard_scan_queue.push_back(static_cast<uint8_t>(scan));
            h.key_queue.push_back(static_cast<uint16_t>((scan << 8u) | ascii));
        }
        return 0;
    }
    case WM_KEYUP:
    case WM_SYSKEYUP: {
        uint16_t scan = static_cast<uint16_t>((static_cast<UINT>(lparam >> 16) & 0xFFu));
        if (scan == 0u) {
            scan = static_cast<uint16_t>(MapVirtualKeyA(static_cast<UINT>(wparam), MAPVK_VK_TO_VSC) & 0xFFu);
        }
        if (scan != 0u) {
            if (g_generated_active_state != NULL) {
                generated_apply_keyboard_scan_to_shift_flags(g_generated_active_state, static_cast<uint8_t>(scan | 0x80u));
            }
            h.keyboard_scan_queue.push_back(static_cast<uint8_t>(scan | 0x80u));
            h.key_down.erase(scan);
        }
        return 0;
    }
    case WM_KILLFOCUS:
        if (g_generated_active_state != NULL) {
            for (std::unordered_set<uint16_t>::const_iterator it = h.key_down.begin(); it != h.key_down.end(); ++it) {
                generated_apply_keyboard_scan_to_shift_flags(g_generated_active_state, static_cast<uint8_t>((*it & 0x00FFu) | 0x80u));
            }
        }
        h.key_down.clear();
        return 0;
    default:
        return DefWindowProcA(hwnd, msg, wparam, lparam);
    }
}

void generated_ensure_window(GeneratedRuntimeState* state) {
    GeneratedHostState& h = generated_host();
    (void)state;
    if (!h.window_class_registered) {
        WNDCLASSA wc{};
        wc.lpfnWndProc = GeneratedHostWindowProc;
        wc.hInstance = GetModuleHandleA(NULL);
        wc.lpszClassName = "mz2cpp_generated_window";
        wc.hCursor = LoadCursor(NULL, IDC_ARROW);
        if (!RegisterClassA(&wc) && GetLastError() != ERROR_CLASS_ALREADY_EXISTS) {
            return;
        }
        h.window_class_registered = true;
    }
    if (h.hwnd == NULL) {
        h.hwnd = CreateWindowExA(0, "mz2cpp_generated_window", "MZEXE2CPP Generated Game",
                                 WS_OVERLAPPEDWINDOW | WS_VISIBLE,
                                 CW_USEDEFAULT, CW_USEDEFAULT, 960, 720,
                                 NULL, NULL, GetModuleHandleA(NULL), NULL);
        if (h.hwnd != NULL) {
            ShowWindow(h.hwnd, SW_SHOW);
            SetForegroundWindow(h.hwnd);
            SetFocus(h.hwnd);
            SetTimer(h.hwnd, kGeneratedPresentTimerId, 16u, NULL);
        }
    }
}

void generated_pump_messages(void) {
    MSG msg;
    while (PeekMessageA(&msg, NULL, 0, 0, PM_REMOVE)) {
        TranslateMessage(&msg);
        DispatchMessageA(&msg);
    }
}

void generated_present_mode13(GeneratedRuntimeState* state) {
    GeneratedHostState& h = generated_host();
    if (h.hwnd == NULL) {
        return;
    }
    if (h.frame_argb.size() != 320u * 200u) {
        h.frame_argb.assign(320u * 200u, 0u);
    }
    {
        size_t i = 0u;
        while (i < h.frame_argb.size()) {
            const uint8_t idx = state->memory[kGeneratedGraphicsVideoPhys + i];
            h.frame_argb[i] = h.palette[idx];
            ++i;
        }
    }
    BITMAPINFO bmi{};
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = 320;
    bmi.bmiHeader.biHeight = -200;
    bmi.bmiHeader.biPlanes = 1;
    bmi.bmiHeader.biBitCount = 32;
    bmi.bmiHeader.biCompression = BI_RGB;
    RECT rc{};
    GetClientRect(h.hwnd, &rc);
    HDC dc = GetDC(h.hwnd);
    StretchDIBits(dc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
                  0, 0, 320, 200, h.frame_argb.data(), &bmi, DIB_RGB_COLORS, SRCCOPY);
    ReleaseDC(h.hwnd, dc);
}

uint16_t generated_pick_mode0d_present_base(const GeneratedHostState& h) {
    {
        const char* forced_page_text = getenv("MZ2CPP_MODE0D_PAGE");
        if (forced_page_text != NULL && forced_page_text[0] != '\0') {
            char* end = NULL;
            const long forced_page = strtol(forced_page_text, &end, 0);
            if (end != forced_page_text && forced_page >= 0 && forced_page < 8) {
                return (uint16_t)((uint16_t)forced_page * 0x2000u);
            }
        }
    }

    return h.crtc_start_addr;
}

void generated_present_mode0d(GeneratedRuntimeState* state) {
    GeneratedHostState& h = generated_host();
    if (h.hwnd == NULL) {
        return;
    }
    if (h.frame_argb.size() != 320u * 200u) {
        h.frame_argb.assign(320u * 200u, 0u);
    }
    {
        const uint16_t base = generated_pick_mode0d_present_base(h);
        generated_render_mode0d_page_to_frame(h, base, &h.frame_argb);
    }
    BITMAPINFO bmi{};
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = 320;
    bmi.bmiHeader.biHeight = -200;
    bmi.bmiHeader.biPlanes = 1;
    bmi.bmiHeader.biBitCount = 32;
    bmi.bmiHeader.biCompression = BI_RGB;
    RECT rc{};
    GetClientRect(h.hwnd, &rc);
    HDC dc = GetDC(h.hwnd);
    StretchDIBits(dc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
                  0, 0, 320, 200, h.frame_argb.data(), &bmi, DIB_RGB_COLORS, SRCCOPY);
    ReleaseDC(h.hwnd, dc);
    (void)state;
}

void generated_present_video(GeneratedRuntimeState* state) {
    generated_ensure_window(state);
    if (generated_host().hwnd == NULL) {
        return;
    }
    if (state->video_mode == 0x0013u) {
        generated_present_mode13(state);
    } else if (state->video_mode == 0x000Du) {
        generated_present_mode0d(state);
    }
}

unsigned generated_phys_is_video(uint32_t phys) {
    return phys >= kGeneratedGraphicsVideoPhys && phys < kGeneratedGraphicsVideoEndPhys;
}

} // namespace

static unsigned generated_trace_env_enabled(const char* name);

const GeneratedNamedStaticSymbol* generated_find_named_static_symbol_covering_phys(uint32_t physical, size_t* byte_offset) {
    return generated_find_region_covering_impl(
        kGeneratedNamedStaticSymbols,
        kGeneratedNamedStaticSymbolCount,
        physical,
        byte_offset,
        [](const GeneratedNamedStaticSymbol& symbol) { return symbol.physical; },
        [](const GeneratedNamedStaticSymbol& symbol) { return symbol.size; });
}

const GeneratedNamedStaticSymbol* generated_find_named_static_symbol_covering(uint16_t segment,
                                                                              uint16_t offset,
                                                                              size_t* byte_offset) {
    return generated_find_named_static_symbol_covering_phys(generated_phys(segment, offset), byte_offset);
}

const GeneratedMemoryRegion* generated_find_code_region_covering_phys(uint32_t physical, size_t* byte_offset) {
    return generated_find_region_covering_impl(
        kGeneratedCodeRegions,
        kGeneratedCodeRegionCount,
        physical,
        byte_offset,
        [](const GeneratedMemoryRegion& region) { return region.physical; },
        [](const GeneratedMemoryRegion& region) { return region.size; });
}

const GeneratedMemoryRegion* generated_find_residual_region_covering_phys(uint32_t physical, size_t* byte_offset) {
    return generated_find_region_covering_impl(
        kGeneratedResidualRegions,
        kGeneratedResidualRegionCount,
        physical,
        byte_offset,
        [](const GeneratedMemoryRegion& region) { return region.physical; },
        [](const GeneratedMemoryRegion& region) { return region.size; });
}

unsigned generated_is_in_named_static_region(uint16_t segment, uint16_t offset) {
    return generated_find_named_static_symbol_covering(segment, offset, NULL) != NULL;
}

unsigned generated_is_named_static_readonly(uint16_t segment, uint16_t offset) {
    const GeneratedNamedStaticSymbol* symbol = generated_find_named_static_symbol_covering(segment, offset, NULL);
    return symbol != NULL && symbol->writable == 0u;
}

unsigned char generated_read_static_u8_phys(const GeneratedRuntimeState* state, uint32_t physical) {
    return state->memory[physical & 0xFFFFFu];
}

uint16_t generated_read_static_u16_phys(const GeneratedRuntimeState* state, uint32_t physical) {
    const uint32_t lo_phys = physical & 0xFFFFFu;
    const uint32_t hi_phys = (physical + 1u) & 0xFFFFFu;
    return static_cast<uint16_t>(state->memory[lo_phys]) |
           static_cast<uint16_t>(static_cast<uint16_t>(state->memory[hi_phys]) << 8u);
}

void generated_write_static_u8_phys(GeneratedRuntimeState* state, uint32_t physical, unsigned char value) {
    state->memory[physical & 0xFFFFFu] = value;
}

void generated_write_static_u16_phys(GeneratedRuntimeState* state, uint32_t physical, uint16_t value) {
    const uint32_t lo_phys = physical & 0xFFFFFu;
    const uint32_t hi_phys = (physical + 1u) & 0xFFFFFu;
    state->memory[lo_phys] = static_cast<unsigned char>(value & 0x00FFu);
    state->memory[hi_phys] = static_cast<unsigned char>((value >> 8u) & 0x00FFu);
}

unsigned char generated_read_u8(const GeneratedRuntimeState* state, uint16_t segment, uint16_t offset) {
    const uint32_t phys = generated_phys(segment, offset);
    if (state->video_mode == 0x000Du && phys >= kGeneratedGraphicsVideoPhys && phys < kGeneratedGraphicsVideoEndPhys) {
        GeneratedHostState& h = generated_host();
        generated_clear_word_latch(h);
        return generated_mode0d_read_byte(state, static_cast<uint16_t>(phys - kGeneratedGraphicsVideoPhys));
    }
    return state->memory[phys];
}

uint16_t generated_read_u16(const GeneratedRuntimeState* state, uint16_t segment, uint16_t offset) {
    const uint32_t phys = generated_phys(segment, offset);
    if (state->video_mode == 0x000Du && phys >= kGeneratedGraphicsVideoPhys && (phys + 1u) < kGeneratedGraphicsVideoEndPhys) {
        GeneratedHostState& h = generated_host();
        const uint16_t poff = static_cast<uint16_t>(phys - kGeneratedGraphicsVideoPhys);
        const uint16_t lo = generated_mode0d_read_byte(state, poff);
        h.gc_word_latch_lo = h.gc_latch;
        const uint16_t hi = generated_mode0d_read_byte(state, static_cast<uint16_t>(poff + 1u));
        h.gc_word_latch_hi = h.gc_latch;
        h.gc_word_latch_off = poff;
        h.gc_word_latch_valid = true;
        {
            const uint16_t value = static_cast<uint16_t>(lo | (hi << 8u));
            if (generated_trace_word_addr_matches(segment, offset)) {
                generated_trace_word_access(state, "read", segment, offset, value);
            }
            return value;
        }
    }
    {
        const uint16_t value = (uint16_t)state->memory[phys] | (uint16_t)(state->memory[(phys + 1u) & 0xFFFFFu] << 8u);
        if (generated_trace_word_addr_matches(segment, offset)) {
            generated_trace_word_access(state, "read", segment, offset, value);
        }
        return value;
    }
}

void generated_write_u8(GeneratedRuntimeState* state, uint16_t segment, uint16_t offset, unsigned char value) {
    const uint32_t phys = generated_phys(segment, offset);
    if (state->video_mode == 0x000Du && phys >= kGeneratedGraphicsVideoPhys && phys < kGeneratedGraphicsVideoEndPhys) {
        GeneratedHostState& h = generated_host();
        const uint16_t poff = static_cast<uint16_t>(phys - kGeneratedGraphicsVideoPhys);
        generated_clear_word_latch(h);
        generated_mode0d_write_byte(state, poff, value);
        state->memory[phys] = generated_mode0d_peek_byte_no_latch(h, poff);
        ++state->host_video_write_count;
        return;
    }
    state->memory[phys] = value;
    if (generated_phys_is_video(phys)) {
        state->video_dirty = 1u;
        ++state->host_video_write_count;
    }
}

void generated_write_u16(GeneratedRuntimeState* state, uint16_t segment, uint16_t offset, uint16_t value) {
    const uint32_t phys = generated_phys(segment, offset);
    if (state->video_mode == 0x000Du && phys >= kGeneratedGraphicsVideoPhys && (phys + 1u) < kGeneratedGraphicsVideoEndPhys) {
        GeneratedHostState& h = generated_host();
        const uint16_t poff = static_cast<uint16_t>(phys - kGeneratedGraphicsVideoPhys);
        if (h.gc_word_latch_valid && h.gc_word_latch_off == poff) {
            h.gc_latch = h.gc_word_latch_lo;
            generated_mode0d_write_byte(state, poff, static_cast<uint8_t>(value & 0x00FFu));
            state->memory[phys] = generated_mode0d_peek_byte_no_latch(h, poff);
            h.gc_latch = h.gc_word_latch_hi;
            generated_mode0d_write_byte(state, static_cast<uint16_t>(poff + 1u), static_cast<uint8_t>((value >> 8u) & 0x00FFu));
            state->memory[phys + 1u] = generated_mode0d_peek_byte_no_latch(h, static_cast<uint16_t>(poff + 1u));
            generated_clear_word_latch(h);
            state->host_video_write_count += 2u;
            if (generated_trace_word_addr_matches(segment, offset)) {
                generated_trace_word_access(state, "write", segment, offset, value);
            }
            return;
        }
        generated_clear_word_latch(h);
    }
    generated_write_u8(state, segment, offset, (unsigned char)(value & 0x00FFu));
    generated_write_u8(state, segment, (uint16_t)(offset + 1u), (unsigned char)((value >> 8u) & 0x00FFu));
    if (generated_trace_word_addr_matches(segment, offset)) {
        generated_trace_word_access(state, "write", segment, offset, value);
    }
}

GENERATED_NOINLINE unsigned char generated_get_reg8(const GeneratedRuntimeState* state, unsigned index) {
    const uint16_t value = (index & 0x03u) == 0u ? state->ax :
                           (index & 0x03u) == 1u ? state->cx :
                           (index & 0x03u) == 2u ? state->dx :
                                                  state->bx;
    if ((index & 0x04u) != 0u) {
        return static_cast<unsigned char>((value >> 8u) & 0x00FFu);
    }
    return static_cast<unsigned char>(value & 0x00FFu);
}

GENERATED_NOINLINE void generated_set_reg8(GeneratedRuntimeState* state, unsigned index, unsigned char value) {
    uint16_t* reg = (index & 0x03u) == 0u ? &state->ax :
                    (index & 0x03u) == 1u ? &state->cx :
                    (index & 0x03u) == 2u ? &state->dx :
                                           &state->bx;
    if ((index & 0x04u) != 0u) {
        *reg = static_cast<uint16_t>((*reg & 0x00FFu) | (static_cast<uint16_t>(value) << 8u));
    } else {
        *reg = static_cast<uint16_t>((*reg & 0xFF00u) | static_cast<uint16_t>(value));
    }
}

void generated_set_flag(GeneratedRuntimeState* state, uint16_t mask, unsigned value) {
    if (value) {
        state->flags |= mask;
    } else {
        state->flags &= (uint16_t)~mask;
    }
}

unsigned generated_get_flag(const GeneratedRuntimeState* state, uint16_t mask) {
    return (state->flags & mask) != 0u;
}

static unsigned generated_even_parity8(unsigned char value) {
    value ^= (unsigned char)(value >> 4u);
    value &= 0x0Fu;
    return ((0x6996u >> value) & 1u) != 0u;
}

unsigned generated_parity_u8(unsigned char value) {
    return generated_even_parity8(value);
}

static void generated_set_logic_flags8(GeneratedRuntimeState* state, unsigned char value) {
    generated_set_flag(state, GENERATED_FLAG_CF, 0u);
    generated_set_flag(state, GENERATED_FLAG_OF, 0u);
    generated_set_flag(state, GENERATED_FLAG_SF, (value & 0x80u) != 0u);
    generated_set_flag(state, GENERATED_FLAG_ZF, value == 0u);
    generated_set_flag(state, GENERATED_FLAG_PF, generated_even_parity8(value));
}

static void generated_set_logic_flags16(GeneratedRuntimeState* state, uint16_t value) {
    generated_set_flag(state, GENERATED_FLAG_CF, 0u);
    generated_set_flag(state, GENERATED_FLAG_OF, 0u);
    generated_set_flag(state, GENERATED_FLAG_SF, (value & 0x8000u) != 0u);
    generated_set_flag(state, GENERATED_FLAG_ZF, value == 0u);
    generated_set_flag(state, GENERATED_FLAG_PF, generated_even_parity8((unsigned char)value));
}

unsigned char generated_logic_u8(GeneratedRuntimeState* state, unsigned char value) {
    generated_set_flag(state, GENERATED_FLAG_CF, 0u);
    generated_set_flag(state, GENERATED_FLAG_OF, 0u);
    generated_set_flag(state, GENERATED_FLAG_AF, 0u);
    generated_set_flag(state, GENERATED_FLAG_SF, (value & 0x80u) != 0u);
    generated_set_flag(state, GENERATED_FLAG_ZF, value == 0u);
    generated_set_flag(state, GENERATED_FLAG_PF, generated_even_parity8(value));
    return value;
}

uint16_t generated_logic_u16(GeneratedRuntimeState* state, uint16_t value) {
    generated_set_flag(state, GENERATED_FLAG_CF, 0u);
    generated_set_flag(state, GENERATED_FLAG_OF, 0u);
    generated_set_flag(state, GENERATED_FLAG_AF, 0u);
