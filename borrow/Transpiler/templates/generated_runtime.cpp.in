            value = (unsigned char)(((value >> 1u) | carry) & 0xFFu);
            generated_set_flag(state, GENERATED_FLAG_CF, (old & 0x01u) != 0u);
            break;
        }
        case 4u:
            value = (unsigned char)((value << 1u) & 0xFFu);
            generated_set_flag(state, GENERATED_FLAG_CF, (old & 0x80u) != 0u);
            break;
        case 5u:
            value = (unsigned char)(value >> 1u);
            generated_set_flag(state, GENERATED_FLAG_CF, (old & 0x01u) != 0u);
            break;
        case 7u:
            value = (unsigned char)(((value >> 1u) | (value & 0x80u)) & 0xFFu);
            generated_set_flag(state, GENERATED_FLAG_CF, (old & 0x01u) != 0u);
            break;
        default:
            return value;
        }
    }

    switch (reg_field) {
    case 0u:
    case 2u:
        generated_set_flag(state, GENERATED_FLAG_OF, ((value & 0x80u) != 0u) != (generated_get_flag(state, GENERATED_FLAG_CF) != 0u));
        break;
    case 1u:
